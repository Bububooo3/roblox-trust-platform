generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                BigInt   @id @default(autoincrement())
  rblxUserID        BigInt   @unique
  robloxUsername    String
  productAccountAge Int
  robloxAccountAge  Int
  lastLogin         DateTime @default(now())

  @@map("Users")
}

model Transaction {
  transactionID     BigInt    @id @default(autoincrement())
  projectName       String
  amountInCents     Int
  clientId          BigInt
  developerId       BigInt
  developerReviewId BigInt?   @unique
  clientReviewId    BigInt?   @unique
  status            Status
  visible           Boolean
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?
  description       String
  currency          String    @default("USD")
  media             Media[]
  clientReview      Review?   @relation("ClientReview", fields: [clientReviewId], references: [reviewID])
  developerReview   Review?   @relation("DeveloperReview", fields: [developerReviewId], references: [reviewID])

  @@index([clientId])
  @@index([developerId])
  @@index([clientId, transactionID])
  @@index([developerId, transactionID])
  @@index([status])
  @@map("Transactions")
}

model Review {
  reviewID            BigInt       @id @default(autoincrement())
  rating              Int
  description         String
  reviewerId          BigInt
  revieweeId          BigInt
  linkedTransactionId BigInt
  asClientReview      Transaction? @relation("ClientReview")
  asDeveloperReview   Transaction? @relation("DeveloperReview")

  @@unique([reviewerId, linkedTransactionId])
  @@index([revieweeId])
  @@index([revieweeId, reviewID])
  @@map("Reviews")
}

model Media {
  mediaId             BigInt      @id @default(autoincrement())
  type                MediaType
  linkedTransactionId BigInt
  contentID           BigInt?
  contentString       String?
  transaction         Transaction @relation(fields: [linkedTransactionId], references: [transactionID])

  @@map("Media")
}

enum Status {
  Success
  Cancelled
  Reported
  Pending
  Ongoing
}

enum MediaType {
  link
  picture
  experience
  group
  asset
}

model Application {
  id        String   @id @default(cuid())
  name      String
  apiKey    String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}
